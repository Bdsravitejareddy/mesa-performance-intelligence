NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for Apps Script imports; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Canonical HTTPS dashboard origin for private installer downloads. On Vercel,
# VERCEL_PROJECT_PRODUCTION_URL is used when APP_BASE_URL is omitted.
APP_BASE_URL=
APP_ALLOWED_EMAILS=
NEXT_PUBLIC_DEMO_MODE=true

# Optional OpenAI-compatible server-side evaluation. All fields are required;
# approval explicitly enables sending relevant excerpts and the selected answer/feedback.
AI_DATA_PROCESSING_APPROVED=false
# Gemini (recommended): set GEMINI_API_KEY and leave AI_API_BASE_URL/AI_API_KEY empty.
# Uses https://generativelanguage.googleapis.com/v1beta/openai and AI_MODEL (default gemini-3.8-flash).
GEMINI_API_KEY=
# Optional fallbacks, tried in order when a key is rejected, rate-limited or Gemini errors.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Server-only LMS and scheduled-sync secrets. Never expose with NEXT_PUBLIC_.
NEXUS_MCP_TOKEN=
CRON_SECRET=

# Optional public discovery only; server-side and never NEXT_PUBLIC_.
# Select tavily or brave, then configure only the selected provider's key.
PUBLIC_SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_API_KEY=

# GitHub App for "Connect GitHub" on Resume & portfolio (read-only: Metadata, Contents, Deployments).
# Callback URL in the app settings: <APP_BASE_URL>/api/github/callback ; enable "Request user authorization
# (OAuth) during installation". Server-only; never expose to the browser.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
